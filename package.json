{
  "name": "portfolio_v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "images:capture": "node scripts/capture-project-screenshots.mjs",
    "images:generate": "node scripts/generate-project-card-thumbnails.mjs && node scripts/generate-project-detail-heroes.mjs && node scripts/generate-project-share-images.mjs && node scripts/generate-site-share-images.mjs",
    "audit:build": "npm run build",
    "audit:lhci:local:desktop": "npm run build && lhci autorun --config=scripts/audit/lhci.local.desktop.cjs",
    "audit:lhci:local:mobile": "npm run build && lhci autorun --config=scripts/audit/lhci.local.mobile.cjs",
    "audit:lhci:live:desktop": "lhci autorun --config=scripts/audit/lhci.live.desktop.cjs",
    "audit:lhci:live:mobile": "lhci autorun --config=scripts/audit/lhci.live.mobile.cjs",
    "audit:playwright:local:desktop": "node scripts/audit/run-playwright.mjs local desktop",
    "audit:playwright:local:mobile": "node scripts/audit/run-playwright.mjs local mobile",
    "audit:playwright:live:desktop": "node scripts/audit/run-playwright.mjs live desktop",
    "audit:playwright:live:mobile": "node scripts/audit/run-playwright.mjs live mobile"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
